{
  "description": "Browse Pixiv rankings.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "date": {
        "description": "Ranking date in YYYY-MM-DD.",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "type": "string"
      },
      "illust_filter": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minimum": 1,
            "type": "integer"
          },
          "min_pages": {
            "minimum": 0,
            "type": "integer"
          },
          "min_views": {
            "minimum": 0,
            "type": "integer"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": {
            "enum": [
              "illust",
              "manga",
              "ugoira"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "limit": {
        "description": "Maximum logical results; 0 returns all; omitted reads one upstream batch.",
        "minimum": 0,
        "type": "integer"
      },
      "mode": {
        "description": "Pixiv ranking mode; omitted defaults to day.",
        "enum": [
          "day",
          "day_male",
          "day_female",
          "week",
          "week_original",
          "week_rookie",
          "month",
          "day_manga",
          "week_manga",
          "month_manga",
          "week_rookie_manga",
          "day_r18",
          "day_male_r18",
          "day_female_r18",
          "week_r18",
          "week_r18g"
        ],
        "type": "string"
      },
      "page": {
        "description": "1-based logical page; requires a positive limit.",
        "minimum": 1,
        "type": "integer"
      }
    },
    "type": "object"
  },
  "name": "illust_ranking",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "access_control": {
        "additionalProperties": true,
        "type": "object"
      },
      "bookmark_tags": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": "array"
      },
      "bookmarked": {
        "type": "boolean"
      },
      "comments": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": "array"
      },
      "content": {
        "additionalProperties": true,
        "type": "object"
      },
      "filter": {
        "additionalProperties": false,
        "properties": {
          "completeness": {
            "type": "string"
          },
          "max": {
            "type": "integer"
          },
          "membership": {
            "type": "string"
          },
          "min": {
            "type": "integer"
          },
          "strategy": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "pagination": {
        "additionalProperties": true,
        "type": "object"
      },
      "records": {
        "items": {
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "url"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "restrict": {
        "type": "string"
      },
      "series": {
        "additionalProperties": true,
        "type": "object"
      },
      "tags": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "total": {
        "type": "integer"
      }
    },
    "required": [
      "records"
    ],
    "type": "object"
  }
}
