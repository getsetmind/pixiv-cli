{
  "description": "Search for novels using keywords with supported filters.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "duration": {
        "description": "Pixiv novel search duration.",
        "type": "string"
      },
      "limit": {
        "description": "Maximum logical results; 0 returns all; omit for one logical batch.",
        "type": "integer"
      },
      "novel_filter": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minimum": 1,
            "type": "integer"
          },
          "min_views": {
            "minimum": 0,
            "type": "integer"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "page": {
        "description": "1-based logical page; requires a positive limit.",
        "type": "integer"
      },
      "search_target": {
        "description": "Pixiv novel search target.",
        "type": "string"
      },
      "sort": {
        "description": "Pixiv novel result order.",
        "type": "string"
      },
      "word": {
        "description": "Novel search keyword.",
        "type": "string"
      }
    },
    "required": [
      "word"
    ],
    "type": "object"
  },
  "name": "search_novel",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "access_control": {
        "additionalProperties": true,
        "type": "object"
      },
      "bookmark_tags": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": "array"
      },
      "bookmarked": {
        "type": "boolean"
      },
      "comments": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": "array"
      },
      "content": {
        "additionalProperties": true,
        "type": "object"
      },
      "filter": {
        "additionalProperties": false,
        "properties": {
          "completeness": {
            "type": "string"
          },
          "max": {
            "type": "integer"
          },
          "membership": {
            "type": "string"
          },
          "min": {
            "type": "integer"
          },
          "strategy": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "pagination": {
        "additionalProperties": true,
        "type": "object"
      },
      "records": {
        "items": {
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "type",
            "url"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "restrict": {
        "type": "string"
      },
      "series": {
        "additionalProperties": true,
        "type": "object"
      },
      "tags": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "total": {
        "type": "integer"
      }
    },
    "required": [
      "records"
    ],
    "type": "object"
  }
}
