        "description": "Optional comment body; empty is the sticker-only wire form.",
        "type": "string"
      },
      "illust_id": {
        "description": "Positive Pixiv artwork ID.",
        "minimum": 1,
        "type": "integer"
      },
      "stamp_id": {
        "description": "Positive Pixiv stamp ID.",
        "minimum": 1,
        "type": "integer"
      }
