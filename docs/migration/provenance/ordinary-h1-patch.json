  "production_boundary": [
    "The actual HyperClient clone is retained before the original retry, redirect and decompression layering",
    "Explicit HTTP1 idle close removes current entries and sets future-idle rejection atomically under the original pool mutex",
    "Waiters are preserved; returning connections are offered to waiters before leftover idle insertion is rejected",
    "New checkout creation clears the rejection flag once; subsequent polling of an existing checkout does not clear it",
    "Active unique leases retain the actual pool; the original body-readiness future decides actual idle return",
    "Each actual HTTP1 idle return receives a fresh cancellation channel and entry ID; its task retains the actual pool and sleeps to its own absolute deadline",
    "Checkout, close, global-limit eviction and driver completion cancel the affected entry task; checked-out senders have no old idle timeout",
    "HTTP1 driver completion marks connection liveness and removes only matching idle entries using a weak observer",
    "Per-host idle bounds reject excess returns; global idle bounds evict the oldest actual idle return across hosts",
    "Physical transport shutdown remains the official connection-driver result, separate from pool sender retirement"
  ],
  "go_ordinary_configuration": {
    "pool_idle_retention": true,
    "pool_max_idle_per_host": 2,
    "pool_max_idle_connections": 100,
