+
+pub(crate) struct DriverObserver<T: Poolable, K: Key> {
+    pool: WeakOpt<Mutex<PoolInner<T, K>>>,
+    key: K,
+    connection: ConnectionId,
+}
+
+impl<T: Poolable, K: Key> DriverObserver<T, K> {
+    pub(crate) fn connection_id(&self) -> ConnectionId {
+        self.connection.clone()
+    }
+}
+
+impl<T: Poolable, K: Key> Drop for DriverObserver<T, K> {
+    fn drop(&mut self) {
+        self.connection.alive.store(false, Ordering::Release);
+        if let Some(pool) = self.pool.upgrade() {
+            if let Ok(mut inner) = pool.lock() {
+                if let Some(entries) = inner.idle.get_mut(&self.key) {
+                    entries.retain(|entry| entry.value.connection_id() != Some(self.connection.id));
+                    if entries.is_empty() {
+                        inner.idle.remove(&self.key);
+                    }
+                }
+            }
+        }
+    }
+}
+
+struct IdleEntryTask<T: Poolable, K: Key> {
+    pool: Arc<Mutex<PoolInner<T, K>>>,
+    key: K,
+    entry_id: u64,
+    cancellation: oneshot::Receiver<Infallible>,
+    deadline: Option<(Timer, Instant)>,
+}
+
+impl<T: Poolable, K: Key> IdleEntryTask<T, K> {
+    async fn run(self) {
+        if let Some((timer, deadline)) = self.deadline {
+            let sleep = timer.sleep_until(deadline);
+            match futures_util::future::select(self.cancellation, sleep).await {
+                futures_util::future::Either::Left(_) => return,
+                futures_util::future::Either::Right(_) => {
+                    if let Ok(mut inner) = self.pool.lock() {
+                        inner.remove_idle_entry(&self.key, self.entry_id);
+                    }
+                }
+            }
+        } else {
+            let _ = self.cancellation.await;
+        }
+    }
 }
 
