+    /// Sets extra data, retaining ownership only after native storage succeeds.
+    #[corresponds(SSL_set_ex_data)]
+    pub fn try_set_ex_data<T>(&mut self, index: Index<Ssl, T>, data: T) -> Result<(), ErrorStack> {
+        if let Some(old) = self.ex_data_mut(index) {
+            *old = data;
+            return Ok(());
+        }
+        unsafe {
+            let data = Box::into_raw(Box::new(data));
+            let result = cvt(ffi::SSL_set_ex_data(self.as_ptr(), index.as_raw(), data.cast()));
+            if result.is_err() {
+                drop(Box::from_raw(data));
+            }
+            result.map(|_| ())
+        }
+    }
