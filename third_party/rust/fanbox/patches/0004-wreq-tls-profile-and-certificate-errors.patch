+                if matches!(checked, Ok(true)) && original.is_ok() {
+                    return true;
+                }
+                let internal_error = checked.err().map(Arc::new);
+                let result = original.err().unwrap_or(X509VerifyError::UNSPECIFIED);
+                let certificate = context.current_cert().and_then(|cert| cert.to_der().ok());
+                let Some(ssl) = context.ex_data_mut(ssl_index) else {
