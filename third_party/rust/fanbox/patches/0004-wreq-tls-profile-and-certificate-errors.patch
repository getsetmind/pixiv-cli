+
+/// Alert policy for a certificate rejected by native verification.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub enum CertificateFailureAlert {
+    /// Preserve the native alert corresponding to the verification failure.
+    #[default]
+    Native,
+    /// Emit bad_certificate after rejecting the certificate; retain the original cause.
+    BadCertificate,
+}
+
+/// Classification of a genuine native certificate verification failure.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum CertificateFailureKind {
+    /// The certificate chain cannot be linked to an accepted trust anchor.
+    UnknownAuthority,
+    /// The certificate does not cover the requested DNS name or IP address.
+    HostnameMismatch,
+    /// The certificate's validity period has ended.
+    Expired,
+    /// The certificate's validity period has not begun.
+    NotYetValid,
+    /// Another certificate or internal native verification failure occurred.
+    Other,
+}
+
+/// Certificate verification cause retained before TLS alert translation.
+#[derive(Debug)]
+pub struct CertificateVerificationError {
+    result: X509VerifyError,
+    certificate: Option<Vec<u8>>,
+    internal_error: Option<Arc<ErrorStack>>,
+    source: btls::ssl::Error,
+}
+
+impl CertificateVerificationError {
+    pub(crate) fn new(
+        result: X509VerifyError,
+        certificate: Option<Vec<u8>>,
+        internal_error: Option<Arc<ErrorStack>>,
+        source: btls::ssl::Error,
+    ) -> Self {
+        Self { result, certificate, internal_error, source }
+    }
+
+    /// Returns the original native verification class.
+    pub fn kind(&self) -> CertificateFailureKind {
+        match self.result {
+            X509VerifyError::UNABLE_TO_GET_ISSUER_CERT
+            | X509VerifyError::DEPTH_ZERO_SELF_SIGNED_CERT
+            | X509VerifyError::SELF_SIGNED_CERT_IN_CHAIN
+            | X509VerifyError::UNABLE_TO_GET_ISSUER_CERT_LOCALLY
+            | X509VerifyError::UNABLE_TO_VERIFY_LEAF_SIGNATURE => CertificateFailureKind::UnknownAuthority,
+            X509VerifyError::HOSTNAME_MISMATCH
+            | X509VerifyError::IP_ADDRESS_MISMATCH => CertificateFailureKind::HostnameMismatch,
+            X509VerifyError::CERT_HAS_EXPIRED => CertificateFailureKind::Expired,
+            X509VerifyError::CERT_NOT_YET_VALID => CertificateFailureKind::NotYetValid,
+            _ => CertificateFailureKind::Other,
+        }
+    }
+
+    /// Returns the original native verification result, not an alert-driving replacement.
+    pub fn verification_result(&self) -> X509VerifyError { self.result }
+
+    /// Returns the actual certificate associated with the native verification failure.
+    pub fn certificate_der(&self) -> Option<&[u8]> { self.certificate.as_deref() }
+
+    /// Returns an internal verifier error, when native verification could not complete.
+    pub fn internal_verification_error(&self) -> Option<&ErrorStack> { self.internal_error.as_deref() }
+}
+
+impl fmt::Display for CertificateVerificationError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(formatter, "certificate verification failed: {}", self.result)
+    }
+}
+
+impl std::error::Error for CertificateVerificationError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> { Some(&self.source) }
+}
 
