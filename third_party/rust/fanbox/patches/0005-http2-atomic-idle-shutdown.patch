+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let mut me = self.inner.lock();
+        if let Some(result) = &me.idle_shutdown {
+            return Poll::Ready(result.clone().map_err(Into::into));
+        }
+        if !me.idle_waiters.iter().any(|waiter| waiter.will_wake(cx.waker())) {
+            me.idle_waiters.push(cx.waker().clone());
+        }
+        Poll::Pending
+    }
