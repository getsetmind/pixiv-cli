+/// A connection control handle that does not keep the request sender alive.
+#[derive(Clone, Debug)]
+pub struct IdleCloseHandle {
+    inner: Arc<Mutex<Inner>>,
+}
+
+/// A reservation retained until a queued request reaches stream creation.
+#[derive(Clone, Debug)]
+pub struct Admission {
+    _inner: Arc<AdmissionRef>,
+}
+
+#[derive(Debug)]
+struct AdmissionRef {
+    inner: Arc<Mutex<Inner>>,
+}
+
+/// Resolves after an idle-retired connection has flushed and shut down its IO.
+#[derive(Debug)]
+pub struct IdleClose {
+    inner: Arc<Mutex<Inner>>,
+}
+
+impl IdleCloseHandle {
+    /// Reserves admission before a request enters an asynchronous dispatch queue.
+    pub fn try_admit(&self) -> Option<Admission> {
+        let mut me = self.inner.lock();
+        if me.idle_retired || me.actions.conn_error.is_some() {
+            return None;
+        }
+        me.pending_admissions += 1;
+        Some(Admission {
+            _inner: Arc::new(AdmissionRef {
+                inner: self.inner.clone(),
+            }),
+        })
+    }
+
+    /// Retires only a connection with no admitted requests or open streams.
+    ///
+    /// `None` leaves a busy connection unchanged. Dropping the returned future
+    /// does not cancel retirement. The connection driver must remain polled.
+    pub fn close_if_idle(&self) -> Option<IdleClose> {
+        let mut me = self.inner.lock();
+        if !me.idle_retired {
+            if me.pending_admissions != 0 || me.actions.conn_error.is_some() {
+                return None;
+            }
+            let mut busy = false;
+            me.store.for_each(|stream| busy |= !stream.state.is_closed());
+            if busy {
+                return None;
+            }
+            me.idle_retired = true;
+        }
+        let task = me.actions.task.take();
+        drop(me);
+        if let Some(task) = task {
+            task.wake();
+        }
+        Some(IdleClose {
+            inner: self.inner.clone(),
+        })
+    }
+
+    /// Reports whether request admission has been closed by idle retirement.
+    pub fn is_retired(&self) -> bool {
+        self.inner.lock().idle_retired
+    }
+}
+
+impl Drop for AdmissionRef {
+    fn drop(&mut self) {
+        self.inner.lock().pending_admissions -= 1;
+    }
+}
