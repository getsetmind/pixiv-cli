+fn logical_authority(headers: &http::HeaderMap) -> Result<RequestAuthority, BoxError> {
+    let mut hosts = headers.get_all(HOST).iter();
+    let host = hosts.next().ok_or("missing Host authority")?;
+    if hosts.next().is_some() {
+        return Err("multiple Host authorities".into());
+    }
+    let text = host.to_str()?;
+    let authority = text.parse::<Authority>()?;
+    if text.contains('@') || authority.host().is_empty() {
+        return Err("invalid Host authority".into());
+    }
+    let port = if text.starts_with('[') {
+        let end = text.find(']').ok_or("invalid IPv6 Host authority")?;
+        text[1..end].parse::<std::net::Ipv6Addr>()?;
+        text.get(end + 1..).filter(|suffix| !suffix.is_empty())
+    } else {
+        text.find(':').map(|start| &text[start..])
+    };
+    if let Some(port) = port {
+        let port = port.strip_prefix(':').ok_or("invalid Host port")?;
+        if port.is_empty() || !port.bytes().all(|byte| byte.is_ascii_digit()) {
+            return Err("invalid Host port".into());
+        }
+        port.parse::<u16>()?;
+    }
+    Ok(RequestAuthority {
+        authority,
+        host: host.clone(),
+    })
+}
