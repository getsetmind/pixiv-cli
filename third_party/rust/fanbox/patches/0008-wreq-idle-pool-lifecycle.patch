 impl<T: Poolable, K: Key> Pool<T, K> {
+    pub fn close_idle_connections(&self) -> BoxFuture<'static, Result<(), BoxError>> {
+        let mut pending = Vec::new();
+        if let Some(enabled) = &self.inner {
+            let mut inner = enabled.lock();
+            let mut empty = Vec::new();
+            for (key, entries) in inner.idle.iter_mut() {
+                entries.retain_mut(|entry| match entry.value.close_idle() {
+                    Some(close) => {
+                        pending.push(close);
+                        false
+                    }
+                    None => true,
+                });
+                if entries.is_empty() {
+                    empty.push(key.clone());
+                }
+            }
+            for key in empty {
+                inner.idle.pop(&key);
+            }
+        }
+        Box::pin(async move {
+            for result in join_all(pending).await {
+                result?;
+            }
+            Ok(())
+        })
+    }
